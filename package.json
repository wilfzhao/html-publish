{
  "name": "html-publish",
  "version": "0.1.9",
  "private": true,
  "scripts": {
    "db:prepare": "prisma generate && prisma migrate deploy",
    "predev": "npm run db:prepare",
    "dev": "next dev --webpack -p 8088",
    "dev:start": "npm run db:prepare && node scripts/dev-service.mjs start",
    "dev:stop": "node scripts/dev-service.mjs stop",
    "dev:status": "node scripts/dev-service.mjs status",
    "build": "next build --webpack",
    "version:info": "node scripts/version-info.mjs",
    "version:set": "node scripts/set-version.mjs",
    "image:build": "node scripts/build-image.mjs",
    "image:build:dev": "node scripts/build-image.mjs",
    "image:release": "node scripts/build-image.mjs --release --push",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "cli": "node packages/html-publish-cli/bin/html-publish.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.19",
    "@tanstack/react-query": "^5.59",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6",
    "lucide-react": "^0.441",
    "next": "^16.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3",
    "react-dom": "^18.3",
    "react-dropzone": "^14.2",
    "sonner": "^1.5",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5",
    "@tailwindcss/typography": "^0.5",
    "@types/adm-zip": "0.5.8",
    "@types/archiver": "^6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "autoprefixer": "^10.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.21",
    "nodemon": "^3.1.14",
    "postcss": "^8.4",
    "prisma": "^5.19",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9",
    "typescript": "^5.6"
  },
  "overrides": {
    "sharp": "^0.35.0"
  }
}
